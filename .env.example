# Variáveis locais (não versionar)
DB_SENHA=troque
JWT_SEGREDO=gere-com-openssl-rand-hex-32
ADMIN_EMAIL=admin@local
ADMIN_SENHA=troque-esta-senha
# Servidor de mapas. Os servidores oficiais do OSM não permitem uso intenso: troque antes de divulgar.
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATRIBUICAO=&copy; colaboradores do OpenStreetMap
COOKIE_SEGURO=false

# IP deste computador na rede local (para o HTTPS de teste: docker compose --profile https up -d)
LAN_IP=

# Cidade atendida (pasta em cidades/). Para preparar outra: veja o README.
CIDADE=resende-rj
